with "../oci_image_manifest.gpr";

project Examples is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("ex1_validate.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;
end Examples;
