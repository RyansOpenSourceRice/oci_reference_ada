with "../oci-reference/oci_reference.gpr";

project Oci_Layer_Apply is
   for Library_Name use "oci_layer_apply";
   for Library_Version use Project'Library_Name & ".so.0.1.0";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-gnatVn");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2");
   end Prove;
end Oci_Layer_Apply;
